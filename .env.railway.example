# Railway Environment Variables

# Database (Railway genera esto automáticamente al conectar PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Node environment
NODE_ENV=production

# Server port (Railway lo provee automáticamente)
PORT=8080

# Security
SESSION_SECRET=your-secret-key-change-this-in-production

# Google OAuth (opcional, solo si usas autenticación de Google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Logging
LOG_LEVEL=info
